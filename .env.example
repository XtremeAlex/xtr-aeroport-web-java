# === xtr-aeroport-web-java — esempio configurazione ===
# Copia in .env e valorizza. Il file .env NON va committato.

# Porta del frontend
SERVER_PORT=8082
HOST_PORT=8082

# Endpoint dell'API interna.
# In locale: http://localhost:8080/xtr-aeroport-api
# Nel cluster (ClusterIP): http://xtr-aeroport-api.<namespace>.svc.cluster.local:8080/xtr-aeroport-api
AEROPORT_API_BASE_URL=http://localhost:8080/xtr-aeroport-api
AEROPORT_API_CONNECT_TIMEOUT_MS=2000
AEROPORT_API_READ_TIMEOUT_MS=5000
